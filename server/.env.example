# --- Общие ---
DEBUG=true

# --- База данных ---
# Локально (SQLite):
DATABASE_URL=sqlite:///./local.db
# В проде (PostgreSQL / Supabase; задавайте секрет только в Render Environment):
# DATABASE_URL=postgresql+psycopg2://zerox00:zerox00pass@db:5432/zerox00space
# Для Supabase используйте новый пароль и connection string из панели проекта.

# --- CORS (через запятую нельзя — задаётся списком в JSON-подобном виде через pydantic-settings) ---
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- YouTube Data API v3 ---
# Получить ключ: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your-youtube-api-key
# ID канала (НЕ handle @0x00space, а именно channel ID вида UCxxxxxxxxxxxx)
# Найти можно через https://commentpicker.com/youtube-channel-id.php
YOUTUBE_CHANNEL_ID=your-channel-id
YOUTUBE_CACHE_TTL_SECONDS=900

# --- Telegram Bot API ---
# Создать бота: @BotFather в Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# ID чата/канала администратора (можно узнать через @userinfobot)
TELEGRAM_ADMIN_CHAT_ID=your-admin-chat-id

# --- Админка ---
# Create named accounts with: python -m scripts.manage_admin create <username>
# Separate secret for signing HttpOnly administrator session cookies.
ADMIN_SESSION_SECRET=change-this-to-a-different-long-random-secret
ADMIN_SESSION_TTL_SECONDS=1800
ADMIN_LOGIN_MAX_FAILURES=5
ADMIN_LOGIN_WINDOW_SECONDS=900
# true only when API is served over HTTPS
COOKIE_SECURE=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
# Реальный IP клиента за прокси (rate limit и блокировка логина).
# Для Render за Cloudflare: cf-connecting-ip. Оставьте пустым локально.
TRUSTED_CLIENT_IP_HEADER=
API_RATE_LIMIT_REQUESTS=120
API_RATE_LIMIT_WINDOW_SECONDS=60
# Optional locally (uses in-memory limits); required with production PostgreSQL.
# Use the private/internal Redis URL from the managed Redis service.
RATE_LIMIT_REDIS_URL=

# --- Background storage ---
# По умолчанию local/Render-compatible каталог backend/uploads/backgrounds.
# На Render для постоянных файлов укажите путь Persistent Disk, например /var/data/backgrounds.
BACKGROUND_UPLOAD_DIR=uploads/backgrounds
# Optional: URL каталога CDN/object storage; оставьте пустым для /media/backgrounds/<file>.
BACKGROUND_PUBLIC_BASE_URL=
# Для Cloudflare R2 (free tier): переключите backend на s3 и задайте параметры ниже.
# Не публикуйте ключи; превышение месячных бесплатных лимитов R2 может тарифицироваться.
BACKGROUND_STORAGE_BACKEND=local
BACKGROUND_S3_ENDPOINT_URL=
BACKGROUND_S3_BUCKET=
BACKGROUND_S3_ACCESS_KEY_ID=
BACKGROUND_S3_SECRET_ACCESS_KEY=
BACKGROUND_S3_REGION=auto
