# --- Общие ---
DEBUG=true

# --- База данных ---
# Локально (SQLite):
DATABASE_URL=sqlite:///./local.db
# В проде (PostgreSQL через docker-compose):
# DATABASE_URL=postgresql+psycopg2://zerox00:zerox00pass@db:5432/zerox00space

# --- CORS (через запятую нельзя — задаётся списком в JSON-подобном виде через pydantic-settings) ---
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- YouTube Data API v3 ---
# Получить ключ: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your-youtube-api-key
# ID канала (НЕ handle @0x00space, а именно channel ID вида UCxxxxxxxxxxxx)
# Найти можно через https://commentpicker.com/youtube-channel-id.php
YOUTUBE_CHANNEL_ID=your-channel-id
YOUTUBE_CACHE_TTL_SECONDS=900

# --- Telegram Bot API ---
# Создать бота: @BotFather в Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# ID чата/канала администратора (можно узнать через @userinfobot)
TELEGRAM_ADMIN_CHAT_ID=your-admin-chat-id

# --- Админка фонов ---
# Сгенерируйте длинную случайную строку и не публикуйте её.
ADMIN_TOKEN=change-this-to-a-long-random-token
