VITE_API_BASE_URL=http://localhost:8000/api
# Необязательно: ID измерения Google Analytics 4 (например G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=
# Optional Sentry DSN. Without a DSN, error reporting is disabled.
VITE_SENTRY_DSN=
VITE_SITE_URL=http://localhost:5173

# Коды подтверждения владения сайтом из Search Console / Вебмастера.
# Добавляются в <head> только если переменная задана.
VITE_GOOGLE_SITE_VERIFICATION=
VITE_YANDEX_VERIFICATION=
VITE_BING_SITE_VERIFICATION=

# Необязательный override API для генерации sitemap при сборке.
SITEMAP_API_BASE_URL=
